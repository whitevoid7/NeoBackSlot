{
  "schemaVersion": 1,
  "id": "neobackslot",
  "version": "${version}",
  "name": "NeoBackSlot",
  "description": "A standalone Fabric back slot and belt slot equipment mod for Minecraft 1.21.1.",
  "authors": [
    "Don Franco"
  ],
  "license": "GPL-3.0-only",
  "icon": "assets/neobackslot/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.backslot.fabric.NeoBackSlotFabric"
    ],
    "client": [
      "net.backslot.fabric.client.NeoBackSlotFabricClient"
    ],
    "modmenu": [
      "net.backslot.fabric.client.config.NeoBackSlotModMenu"
    ]
  },
  "mixins": [
    "neobackslot.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "1.21.1",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
